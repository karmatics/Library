  "type": "luno-library",
  "main": [
    "DomBasics.js",
    "UITools.js",
    "ThreeJSLoader.js",
    "DocumentReader.js",
    "VideoPlayer.js",
    "DictationWidget.js",
    "SliderControl.js",
    "ColorPicker.js",
    "KeyCommandHandler.js",
    "SidePanel.js",
    "CodeMirrorWidget.js",
    "CommunityOracle.js",
    "CadPlanDataRegistry.js",
    "CadPlanItemNotes.js",
    "CadPlanDocumentEditor.js",
    "CadPlanAardvark.js"
